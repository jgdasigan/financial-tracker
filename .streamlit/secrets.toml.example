# Copy this file to .streamlit/secrets.toml and fill in your own values.
# Never commit the real secrets.toml — it's already in .gitignore.
#
# Keep postgres selected until the final DynamoDB verification passes.
DATA_BACKEND = "postgres"

DB_URL = "postgresql://postgres:your-password@your-project.supabase.co:5432/postgres"

# Use a restricted IAM access key that can access only financial-tracker-prod.
AWS_ACCESS_KEY_ID = "replace-me"
AWS_SECRET_ACCESS_KEY = "replace-me"
AWS_DEFAULT_REGION = "ap-southeast-2"
DYNAMODB_TABLE_NAME = "financial-tracker-prod"
DYNAMODB_APP_ID = "default"

# Gate for the whole app (lib/auth.py) — pick your own, this is a single-user
# app so there's no username, just a shared password.
APP_PASSWORD = "change-me"
