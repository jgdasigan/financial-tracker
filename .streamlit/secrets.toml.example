# Copy this file to .streamlit/secrets.toml and fill in your own connection
# string. Never commit the real secrets.toml — it's already in .gitignore.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
#           (use the "Session pooler" URI if you're on IPv4-only network)
# Neon:     Project Dashboard -> Connection Details -> Connection string
#
# Either way it looks like:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME

DB_URL = "postgresql://postgres:your-password@your-project.supabase.co:5432/postgres"

# Gate for the whole app (lib/auth.py) — pick your own, this is a single-user
# app so there's no username, just a shared password.
APP_PASSWORD = "change-me"
